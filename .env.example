# Application Settings
APP_NAME="Intelligent Knowledge Hub"
APP_ENV="production"
DEBUG=False
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["https://winelogbooks.com", "http://localhost:8000", "http://localhost:3000"]

# Azure AI Search Configuration
AZURE_SEARCH_SERVICE_ENDPOINT="https://<your-search-service-name>.search.windows.net"
AZURE_SEARCH_API_KEY="<your-azure-search-admin-key>"
AZURE_SEARCH_INDEX_NAME="enterprise-knowledge-index"
AZURE_SEARCH_SEMANTIC_CONFIG_NAME="knowledge-semantic-config"

# Azure AI Foundry / Azure OpenAI Model Configuration
AZURE_OPENAI_ENDPOINT="https://<your-openai-resource-name>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-azure-openai-key>"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

# Mock Mode (Set to true to test full end-to-end UI & API flow without cloud credentials)
ENABLE_MOCK_FALLBACK=True
